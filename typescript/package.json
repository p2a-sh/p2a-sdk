{
  "name": "p2a-sdk",
  "version": "0.2.1",
  "description": "SDK for p2a agents that run your own code",
  "keywords": [
    "p2a",
    "agents",
    "mcp",
    "sdk"
  ],
  "homepage": "https://p2a.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p2a-sh/p2a-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/p2a-sh/p2a-sdk/issues"
  },
  "author": "p2a <info@p2a.sh>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  }
}
